# The hosted console, behind the approval gate, accounts in Supabase.
# Installed by deploy/setup_server.sh; Caddy terminates HTTPS in front of it.
[Unit]
Description=AnokhiDrishti console (hosted demonstration, behind approval)
After=network-online.target
Wants=network-online.target

[Service]
User=anokhi
Group=anokhi
WorkingDirectory=/opt/anokhidrishti
# The seal key for the access log lives in the service's own state directory.
Environment=PS26150_SEAL_KEY=/var/lib/anokhidrishti/ledger_seal.key
Environment=PYTHONUNBUFFERED=1
# Optional switches, kept out of this file: e.g.
#   SERVE_EXTRA=--mail --mail-env /etc/anokhidrishti/mail.env --field-key /etc/anokhidrishti/field.key
#   (add --real-cases-for demo to show the real cases to that account only;
#   see docs/ACCESS_CONTROL.md)
EnvironmentFile=-/etc/anokhidrishti/serve.env
# Binds 127.0.0.1 only (viewer/server.py); Caddy is the one public listener.
ExecStart=/usr/bin/python3 cli.py serve --out /srv/anokhidrishti/out --port 8150 \
    --require-access --access-store supabase \
    --supabase-env /etc/anokhidrishti/supabase.env \
    --cookie-secure --trust-proxy $SERVE_EXTRA
Restart=always
RestartSec=3

StateDirectory=anokhidrishti
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/anokhidrishti /var/lib/anokhidrishti
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
