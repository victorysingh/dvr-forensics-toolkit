{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:demo",
  "outputDirectory": "dist-demo",
  "installCommand": "npm install",
  "framework": null,
  "rewrites": [
    { "source": "/api/cases", "destination": "/demo-data/cases.json" },
    { "source": "/api/vendors", "destination": "/demo-data/vendors.json" },
    { "source": "/api/case/:id", "destination": "/demo-data/case-:id.json" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ]
}
