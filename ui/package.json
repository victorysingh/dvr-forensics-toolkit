{
  "name": "anokhidrishti-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AnokhiDrishti DVR forensics case console. `build` writes viewer/static/, which is committed and shipped inside the packaged executable - an air-gapped machine never needs Node. `build:demo` writes dist-demo/ for the hosted demonstration and never touches viewer/static/.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:demo": "vite build --mode demo --outDir dist-demo --emptyOutDir"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "tailwindcss": "^4.1.14",
    "vite": "^7.1.9"
  }
}
